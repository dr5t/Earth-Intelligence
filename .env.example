# ==============================================================================
# EARTH INTELLIGENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL API KEYS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
CACHE_TTL_SECONDS=3600
OPEN_METEO_TIMEOUT_MS=10000
ENABLE_LIVE_WEATHER_SYNC=true
DEFAULT_BASIN=ganga

# ------------------------------------------------------------------------------
# MULTIMODAL AI & EVIDENCE SYNTHESIS (Gemma 4 / Gemini Fallback)
# ------------------------------------------------------------------------------
# Models used by backend/gemma.js for environmental reasoning
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite

# Google AI Studio / Gemini API Key (optional fallback if Bedrock not configured)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# Amazon Bedrock (Primary Gemma 4 Provider — tried first when keys are set)
# AWS Console > Bedrock > API Keys & Model Access
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=

# ------------------------------------------------------------------------------
# EXTERNAL ENVIRONMENTAL APIS
# ------------------------------------------------------------------------------
# Global Forest Watch API (optional for live GFW queries; baseline dataset fallback active)
# Obtain from: https://www.globalforestwatch.org/
GFW_API_KEY=

# Copernicus Data Space Ecosystem / Sentinel Hub (optional for live STAC satellite tiles)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
